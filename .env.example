# Local automation is the default. Set windmill to use the external flow.
AUTOMATION_PROVIDER=local

DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@localhost:5432/REPLACE_DATABASE
# Set a new local password before seeding.
DEMO_PASSWORD=REPLACE_WITH_A_NEW_LOCAL_PASSWORD

# Generated by npm.cmd run ingest:setup. Never use NEXT_PUBLIC_ for this key.
INGEST_API_KEY=REPLACE_WITH_64_HEX_CHARACTERS
# Optional simulator target if you run the app on a different port:
SENTINELX_URL=http://localhost:3000

# Required only when AUTOMATION_PROVIDER=windmill.
WINDMILL_WEBHOOK_URL=
WINDMILL_TOKEN=
